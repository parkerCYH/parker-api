PORT=3001
DATABASE_URL=postgres://parker:parker@localhost:5432/parker_api
TEST_DATABASE_URL=postgres://parker:parker@localhost:5432/parker_api_test

JWT_SECRET=dev-jwt-secret-change-me

# Google OAuth client (console.cloud.google.com). auth (Player login) and admin (User
# application/login) use the same client but different callback paths — both redirect URIs
# must be registered as authorized redirect URIs on the client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback
ADMIN_GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/admin/login/google/callback

# Single Admin Dashboard origin (ADR-0008) — unlike Player login (AUTH_APP_DOMAINS), there's
# only one Admin Dashboard, so no domain table. The OAuth callback redirects here to
# ${ADMIN_DASHBOARD_URL}/auth/callback with a pending userId or a one-time exchange code.
ADMIN_DASHBOARD_URL=http://localhost:3000

# Comma-separated emails auto-approved as SuperAdmin on first login (ADR-0001 bootstrap)
SUPER_ADMIN_EMAILS=

# Referer host -> { app, redirectUrl } (ADR-0006). Player login at /api/v1/auth/google resolves
# which app is logging in from this table; unknown/missing Referer is rejected with 400, no
# fallback. redirectUrl must be the app's own callback page — it receives ?accessToken=&refreshToken=.
AUTH_APP_DOMAINS={"localhost:5173":{"app":"catCare","redirectUrl":"http://localhost:5173/login/callback"}}

# apps/eve（票 07/17 定案）：兩組獨立共享密鑰。
# PARKER_TO_EVE_KEY 是 parker-api 呼叫 eve 時帶的密鑰（eve 端驗證），
# EVE_TO_PARKER_KEY 是 eve callback 回 parker-api 時帶的密鑰（parker-api 端驗證，實際 handler 留給後續票）。
# 兩邊的值必須跟 apps/eve/.env.local 一致。
EVE_BASE_URL=http://localhost:3003
PARKER_TO_EVE_KEY=
EVE_TO_PARKER_KEY=

# parker-api 自己對外可被呼叫到的位址(票 20):組成給 eve 的 callback URL 用。本機開發用
# devrun 登記的 parker-api-dev port(3002);正式環境填 Render 對外網域。
PARKER_API_BASE_URL=http://localhost:3002

PORT=3001
DATABASE_URL=postgres://parker:parker@localhost:5432/parker_api
TEST_DATABASE_URL=postgres://parker:parker@localhost:5432/parker_api_test

JWT_SECRET=dev-jwt-secret-change-me

# Google OAuth client (console.cloud.google.com). auth (Player login) and admin (User
# application/login) use the same client but different callback paths — both redirect URIs
# must be registered as authorized redirect URIs on the client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback
ADMIN_GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/admin/login/google/callback

# Comma-separated emails auto-approved as SuperAdmin on first login (ADR-0001 bootstrap)
SUPER_ADMIN_EMAILS=
